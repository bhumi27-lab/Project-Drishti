# Copy to .env (never commit .env)

# Backend
APP_ENV=development
DATABASE_URL=postgresql+psycopg://drishti:drishti@localhost:5432/drishti
CHROMA_URL=http://localhost:8001
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text

# Decision gate
CONFIDENCE_THRESHOLD=0.8

# Mitigation. Keep "simulated" unless you know exactly what you are doing.
MITIGATION_MODE=simulated
# Comma-separated IPs that must never be blocked (localhost, gateway, dev machine)
IP_ALLOWLIST=127.0.0.1,::1

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
VITE_USE_MOCKS=true

# docker-compose
POSTGRES_USER=drishti
POSTGRES_PASSWORD=drishti
POSTGRES_DB=drishti
